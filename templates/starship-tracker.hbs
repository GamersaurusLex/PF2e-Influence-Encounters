<section class="influence-tracker {{#unless isGM}}player-view{{/unless}}">
  <header class="encounter-header starship-header">
    <img src="{{heart.image}}" alt="{{heart.name}}">
    <div><h2>{{encounter.name}}{{#if isPaused}} (Paused){{/if}}</h2><p>Round {{encounter.currentRound}} · {{#if roleSelectionStage}}Crew role selection{{else}}Crew actions{{/if}}{{#if starshipOutcome}} · {{starshipOutcome}}{{/if}}</p></div>
    {{#if hasStarshipClock}}<div class="points">{{starship.countdown.label}} {{starship.countdown.display}}</div>{{/if}}
  </header>
  <nav class="tracker-tabs tabs" data-group="tracker"><a class="item {{tabs.encounter.cssClass}}" data-action="tab" data-group="tracker" data-tab="encounter"><i class="fas fa-shuttle-space"></i> Starship Encounter</a><a class="item {{tabs.log.cssClass}}" data-action="tab" data-group="tracker" data-tab="log"><i class="fas fa-list"></i> Check Log</a></nav>
  {{#if playerRollChecks.length}}<section class="player-roll-queue player-action-dock" aria-live="polite"><h3>Your Action</h3>{{#each playerRollChecks}}<article><div>{{#if canRoll}}<strong>Ready to roll: {{activityLabel}}</strong>{{else}}<strong>Roll recorded</strong>{{/if}}<small>{{actorName}} → {{npcName}} · {{skillLabel}}</small>{{#if canSubmit}}<small>Spend a Hero Point from your check card if you want, then submit the final result.</small>{{/if}}</div>{{#if canRoll}}<button type="button" data-action="roll-approved-check" data-id="{{id}}"><i class="fas fa-dice-d20"></i> Roll {{skillLabel}}</button>{{/if}}{{#if canSubmit}}<button type="button" data-action="submit-approved-check" data-id="{{id}}"><i class="fas fa-paper-plane"></i> Submit Final Result</button>{{/if}}</article>{{/each}}</section>{{/if}}
  <div class="tracker-content">
    <div class="tab {{tabs.encounter.cssClass}}" data-group="tracker" data-tab="encounter">
      <section class="starship-status-grid">
        <article class="npc-profile starship-ship-card"><img src="{{primorata.image}}" alt="{{primorata.name}}"><div><h3>{{primorata.name}}</h3>{{#if primorata.showHullStatus}}<p>{{primorata.hullStatus}}</p>{{/if}}{{#if primorata.showExplicitStats}}<small>Hull {{primorata.hp}} / {{primorata.maxHp}} · Shields {{primorata.shields}} / {{primorata.maxShields}} · AC {{primorata.ac}}</small>{{/if}}</div></article>
        <article class="npc-profile starship-ship-card"><img src="{{heart.image}}" alt="{{heart.name}}"><div><h3>{{heart.name}}</h3>{{#if heart.showHullStatus}}<p>{{heart.hullStatus}}</p>{{/if}}{{#if heart.showExplicitStats}}<small>Hull {{heart.hp}} / {{heart.maxHp}} · Shields {{heart.shields}} / {{heart.maxShields}} · AC {{heart.ac}}</small>{{/if}}</div></article>
      </section>
      {{#if hasStarshipClock}}<section class="npc-profile starship-countdown"><strong>{{starship.countdown.label}}</strong><span>{{starship.countdown.display}}</span>{{#if isGM}}<button data-action="starship-adjust" data-path="countdown" data-delta="-1"><i class="fas fa-minus"></i></button><button data-action="starship-adjust" data-path="countdown" data-delta="1"><i class="fas fa-plus"></i></button>{{/if}}</section>{{/if}}
      <section class="starship-crew-roster"><div class="starship-section-heading"><h3>Crew</h3><small>Round assignments</small></div>
      <ul class="participant-roster">{{#each actors}}<li class="{{#if acted}}acted{{/if}}"><i class="fas {{#if acted}}fa-check-circle{{else}}fa-circle{{/if}}"></i> {{name}} <small>— {{roleLabel}}{{#if acted}}, acted{{/if}}</small></li>{{/each}}</ul>
      </section>
      {{#if controlledActors.length}}<div class="starship-section-heading crew-selector-heading"><h4>Choose your PC</h4><small>Select a crew member to assign</small></div><div class="participants participant-actions starship-crew-selector">{{#each controlledActors}}<button type="button" data-action="select-participant" data-actor-id="{{id}}" class="participant {{#if selected}}selected{{/if}} {{#if acted}}acted{{/if}}"><i class="fas fa-user"></i> {{name}}</button>{{/each}}</div>{{/if}}
      {{#if starshipOutcome}}
        <section class="npc-profile starship-outcome"><h3><i class="fas {{#if starshipVictory}}fa-trophy{{else}}fa-flag{{/if}}"></i> Starship {{starshipOutcome}}</h3><p>{{#if starshipVictory}}The enemy ship has been defeated. End and publish this encounter when you are ready.{{else}}The encounter has ended in defeat. End and publish this encounter when you are ready.{{/if}}</p></section>
        {{#if canEndEncounter}}<footer><button data-action="edit"><i class="fas fa-pen-to-square"></i> Edit Encounter</button><button class="end-encounter" data-action="end-encounter"><i class="fas fa-flag-checkered"></i> End & Publish</button></footer>{{/if}}
      {{else}}{{#if roleSelectionStage}}
        <section class="starship-role-board"><div class="starship-section-heading"><h3>Claim a crew role</h3><small>Every PC selects one station</small></div><p class="hint">Choose any open role for this round. The GM begins crew actions when ready.</p>{{#each roleEntries}}<article class="npc-profile starship-role-card {{#if selected}}selected{{/if}} {{#if claimed}}claimed{{/if}} {{#if showClaim}}available{{/if}}"><div><h4>{{label}} <small>{{assignments.length}} / {{capacity}}</small></h4>{{#if assignments.length}}<p>{{#each assignments}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{else}}<p>Open</p>{{/if}}</div>{{#if @root.canClaimRole}}{{#if showUnclaim}}<button data-action="unclaim-starship-role" data-role-id="{{id}}">Unclaim</button>{{else}}{{#if showClaim}}<button data-action="claim-starship-role" data-role-id="{{id}}">Claim</button>{{else}}{{#if claimed}}<span class="starship-role-claimed">Claimed</span>{{/if}}{{/if}}{{/if}}{{/if}}</article>{{/each}}</section>
        {{#if isGM}}<footer><button data-action="start-starship-round" {{#unless roleSelectionComplete}}disabled title="Some participating PCs have not claimed a role"{{/unless}}><i class="fas fa-play"></i> Start Round</button><button data-action="edit"><i class="fas fa-pen-to-square"></i> Edit Encounter</button>{{#if canOpenForPlayers}}<button data-action="open-for-players"><i class="fas fa-up-right-from-square"></i> Open for Players</button>{{/if}}{{#if canPause}}<button class="pause-encounter" data-action="pause"><i class="fas fa-pause"></i> Pause</button>{{/if}}</footer>{{/if}}
      {{else}}
        {{#if selectedRole}}<section class="starship-action-board"><h3>{{selectedRole.label}} Actions</h3>{{#each activities}}<article class="npc-profile starship-action-card {{#if selected}}selected{{/if}}"><button data-action="select-starship-action" data-activity-id="{{id}}"><strong>{{label}}</strong><small>{{difficulty}}</small></button><p>{{description}}</p>{{#if selected}}{{#if choices.length}}<select data-starship-skill data-activity-id="{{id}}">{{#each choices}}<option value="{{slug}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<p class="hint">This PC has no trained eligible statistic for this activity.</p>{{/if}}{{#if proposalChoices.length}}<select data-starship-proposal data-activity-id="{{id}}"><option value="">Propose another trained skill…</option>{{#each proposalChoices}}<option value="{{slug}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}{{/if}}</article>{{/each}}{{#if canTakeStarshipAction}}<button class="starship-take-action" data-action="take-starship-action"><i class="fas fa-paper-plane"></i> Take My Selected Action</button>{{/if}}</section>{{else}}<p class="hint">Select one of your participating PCs, then claim a role before the GM starts the round.</p>{{/if}}
        {{#if isGM}}<footer><button data-action="next-starship-round"><i class="fas fa-forward"></i> Begin Next Round</button><button data-action="undo"><i class="fas fa-undo"></i> Undo</button><button data-action="edit"><i class="fas fa-pen-to-square"></i> Edit Encounter</button>{{#if canPause}}<button class="pause-encounter" data-action="pause"><i class="fas fa-pause"></i> Pause</button>{{/if}}</footer>{{/if}}
      {{/if}}{{/if}}
      {{#if isGM}}{{#if pendingChecks.length}}<section class="pending-check-queue"><h3>Pending Crew Actions</h3>{{#each pendingChecks}}<article><span class="queue-position">{{position}}</span><div><strong>{{actorName}} — {{activityLabel}}</strong><small>{{skillLabel}}</small>{{#if statusLabel}}<small>{{statusLabel}}</small>{{/if}}</div>{{#if canAdjudicate}}<button type="button" data-action="adjudicate-request" data-id="{{id}}"><i class="fas fa-gavel"></i> Adjudicate</button>{{/if}}<button type="button" data-action="resolve-request-manually" data-id="{{id}}"><i class="fas fa-wand-magic-sparkles"></i> Resolve Manually</button>{{#if canReopen}}<button type="button" data-action="reopen-player-roll" data-id="{{id}}"><i class="fas fa-rotate-left"></i> Reopen Player Roll</button>{{/if}}<button type="button" data-action="forget-request" data-id="{{id}}"><i class="fas fa-eraser"></i> Forget</button><button type="button" data-action="cancel-request" data-id="{{id}}"><i class="fas fa-xmark"></i> Cancel</button></article>{{/each}}</section>{{/if}}{{/if}}
      {{#if canDeclareStarshipOutcome}}<footer><button data-action="declare-starship-outcome" data-outcome="victory"><i class="fas fa-trophy"></i> Declare Victory</button><button data-action="declare-starship-outcome" data-outcome="failure"><i class="fas fa-flag"></i> Declare Defeat</button></footer>{{/if}}
    </div>
    <div class="tab {{tabs.log.cssClass}}" data-group="tracker" data-tab="log">{{#if checkLog.length}}<div class="check-log"><div class="check-log-header"><strong>PC</strong><strong>Target</strong><strong>Check</strong><strong>Skill</strong><strong>Outcome</strong></div>{{#each checkLog}}<div class="check-log-entry"><span>{{actorName}}</span><span>{{npcName}}</span><span>{{typeLabel}}</span><span>{{skillLabel}}</span><span>{{displayOutcome}}</span></div>{{/each}}</div>{{else}}<p class="hint empty-log">No crew actions have been completed.</p>{{/if}}</div>
  </div>
</section>
