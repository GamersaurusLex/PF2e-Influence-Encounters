<section class="influence-tracker">
  {{#if noEncounter}}<p>No active encounter.</p>{{#if isGM}}<button data-action="manage"><i class="fas fa-cog"></i> Manage Encounters</button>{{/if}}{{else}}
  <header class="encounter-header"><img src="{{activeNpc.image}}" alt="{{activeNpc.name}}"><div><h2>{{encounter.name}}{{#if isPaused}} (Paused){{/if}}</h2><p>{{activeNpc.name}} · {{#if isResearch}}{{encounter.researchInterval.value}} {{encounter.researchInterval.unit}} interval{{else}}{{#if isChase}}Round {{encounter.currentRound}}{{else}}{{#if isSkill}}Round {{encounter.currentRound}}{{#if encounter.roundLimit}} of {{encounter.roundLimit}}{{/if}}{{else}}Phase {{encounter.currentPhase}} of {{encounter.phases}}{{/if}}{{/if}}{{/if}}</p></div><div class="points">{{#if showPoints}}{{currentPoints}}{{#if isChase}} / {{activeNpc.maximumPoints}}{{else}}{{#if isSkill}} / {{encounter.skillPointGoal}}{{/if}}{{/if}} {{pointLabel}}{{else}}— {{pointLabel}}{{/if}}</div></header>
  <nav class="tracker-tabs tabs" data-group="tracker"><a class="item" data-tab="encounter"><i class="fas fa-comments"></i> Encounter</a><a class="item" data-tab="log"><i class="fas fa-list"></i> Check Log</a></nav>
  <div class="tracker-content"><div class="tab" data-group="tracker" data-tab="encounter">
    {{#if isChase}}<section class="chase-overview"><img src="{{encounter.chaseSubject.image}}" alt="{{encounter.chaseSubject.name}}"><div><h3>{{encounter.chaseSubject.label}}: {{#if encounter.chaseSubject.nickname}}{{encounter.chaseSubject.nickname}}{{else}}{{encounter.chaseSubject.name}}{{/if}}</h3>{{#if obscureChaseCourse}}<small class="chase-relative-status">{{chaseSubjectStatus}}</small>{{else}}<small>Pace {{encounter.opponentPace}} · Acts {{encounter.subjectTurnOrder}} the party</small>{{/if}}{{#if encounter.chaseDescription}}<p>{{encounter.chaseDescription}}</p>{{/if}}</div></section>{{/if}}
    {{#if isSkill}}{{#if encounter.skillDescription}}<section class="npc-profile"><h3>Situation and Stakes</h3><p>{{encounter.skillDescription}}</p></section>{{/if}}{{/if}}
    <h3>{{targetLabel}}</h3><div class="npc-status-list">{{#each npcs}}<button type="button" data-action="select-npc" data-npc-id="{{id}}" class="npc-status-card {{#if active}}selected{{/if}} {{#if subjectHere}}subject-here{{/if}}"><img src="{{image}}" alt=""><span><strong>{{name}}</strong>{{#if subjectHere}}<small><i class="fa-solid fa-location-dot"></i> {{@root.encounter.chaseSubject.label}} is here</small>{{/if}}{{#unless @root.isSkill}}{{#if showPoints}}<small>{{points}}{{#if @root.isResearch}}{{#if maximumPoints}} / {{maximumPoints}}{{/if}} RP · {{availability}}{{else}}{{#if @root.isChase}} / {{maximumPoints}} CP · {{availability}}{{else}} IP{{/if}}{{/if}}</small>{{/if}}{{/unless}}{{#if @root.isResearch}}{{#if researchActorState}}<small>{{@root.researchActorLabel}}: {{#if showPoints}}{{researchActorState.points}}{{#if researchActorState.maximum}} / {{researchActorState.maximum}}{{/if}} RP · {{/if}}{{researchActorState.availability}}</small>{{/if}}{{/if}}</span></button>{{/each}}</div>
    <section class="npc-profile"><h3>{{activeNpc.name}}</h3>{{#if isSkill}}{{#if activeNpc.background}}<p>{{activeNpc.background}}</p>{{/if}}{{#if overcomeChecks.length}}<p><strong>Checks:</strong> {{#each overcomeChecks}}{{label}}{{#if dcText}} ({{dcText}}){{/if}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}{{#if activeNpc.requirements}}<p><strong>Special:</strong> {{activeNpc.requirements}}</p>{{/if}}{{else}}{{#if isChase}}{{#if activeNpc.background}}<p>{{activeNpc.background}}</p>{{/if}}{{#if overcomeChecks.length}}<p><strong>Overcome:</strong> {{#each overcomeChecks}}{{label}}{{#if dcText}} ({{dcText}}){{/if}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}{{#if activeNpc.requirements}}<p><strong>Special:</strong> {{activeNpc.requirements}}</p>{{/if}}{{else}}{{#if isResearch}}{{#if activeNpc.background}}<p>{{activeNpc.background}}</p>{{/if}}{{#if activeNpc.requirements}}<p><strong>Requirements:</strong> {{activeNpc.requirements}}</p>{{/if}}{{else}}{{#if activeNpc.appearance}}<p><strong>Appearance:</strong> {{activeNpc.appearance}}</p>{{/if}}{{#if isGM}}{{#if activeNpc.background}}<p><strong>Background:</strong> {{activeNpc.background}}</p>{{/if}}{{#if activeNpc.personality}}<p><strong>Personality:</strong> {{activeNpc.personality}}</p>{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}</section>
    {{#if isGM}}<div class="threshold-track">{{#each thresholds}}<div class="threshold {{#if unlocked}}unlocked{{/if}}"><strong>{{points}}</strong><span>{{label}}</span></div>{{/each}}</div>{{/if}}
    <h3>Participants</h3><ul class="participant-roster">{{#each actors}}<li class="{{#if acted}}acted{{/if}}"><i class="fas {{#if acted}}fa-check-circle{{else}}fa-circle{{/if}}"></i> {{name}}{{#if acted}} <small>— acted</small>{{/if}}</li>{{/each}}</ul>
    {{#if controlledActors.length}}<h4>Choose Your Acting PC</h4><div class="participants participant-actions">{{#each controlledActors}}<button type="button" data-action="select-participant" data-actor-id="{{id}}" class="participant {{#if acted}}acted{{/if}} {{#if selected}}selected{{/if}}" {{#if acted}}disabled{{/if}}><i class="fas {{#if acted}}fa-check{{else}}fa-user{{/if}}"></i> {{name}}</button>{{/each}}</div>{{else}}<p class="hint">You do not own any participating PCs.</p>{{/if}}
    {{#unless isResearch}}{{#if knownDiscoveries.length}}<section class="known-discoveries"><h3>Your Discoveries About {{activeNpc.name}}</h3><ul>{{#each knownDiscoveries}}<li>{{this}}</li>{{/each}}</ul></section>{{/if}}{{/unless}}
    {{#if canAct}}<div class="player-actions">{{#if isResearch}}<button data-action="request" data-type="research"><i class="fas fa-book-open"></i> Research</button>{{else}}{{#if isChase}}<button data-action="request" data-type="chase"><i class="fas fa-person-running"></i> Roll to Overcome</button>{{else}}{{#if isSkill}}<button data-action="request" data-type="skill"><i class="fas fa-dice-d20"></i> Make a Check</button>{{else}}<button data-action="request" data-type="discovery"><i class="fas fa-search"></i> Discovery</button><button data-action="request" data-type="influence"><i class="fas fa-comments"></i> Influence</button>{{/if}}{{/if}}{{/if}}</div>{{/if}}
    <div class="results">{{#each thresholds}}{{#if unlocked}}<article><h4>{{label}}</h4><p>{{text}}</p>{{#if boons.length}}<ul>{{#each boons}}<li><strong>{{label}}</strong>{{#if description}} — {{description}}{{/if}}</li>{{/each}}</ul>{{/if}}</article>{{/if}}{{/each}}</div>
    {{#if isGM}}{{#if pendingChecks.length}}<section class="pending-check-queue"><h3>Pending Checks</h3>{{#each pendingChecks}}<article><span class="queue-position">{{position}}</span><div><strong>{{actorName}} — {{npcName}}</strong><small>{{skillLabel}}</small></div><button type="button" data-action="adjudicate-request" data-id="{{id}}"><i class="fas fa-gavel"></i> Adjudicate</button><button type="button" data-action="cancel-request" data-id="{{id}}"><i class="fas fa-xmark"></i> Cancel</button></article>{{/each}}</section>{{/if}}{{/if}}
    {{#if isGM}}<footer>{{#if canPrior}}<button data-action="prior"><i class="fas fa-backward"></i> Prior Phase</button>{{/if}}{{#if canNext}}<button data-action="advance"><i class="fas fa-forward"></i> Next Phase</button>{{/if}}{{#if canNextRound}}<button data-action="next-round"><i class="fas fa-forward"></i> {{roundActionLabel}}</button>{{#if isChase}}<button data-action="pass-obstacle"><i class="fas fa-person-walking-arrow-right"></i> Pass / Unable</button>{{/if}}{{/if}}{{#if canPause}}<button data-action="reset-actions">Reset Actions</button><button data-action="change-ip" data-delta="-1"><i class="fas fa-minus"></i> 1 {{pointLabel}}</button><button data-action="change-ip" data-delta="1"><i class="fas fa-plus"></i> 1 {{pointLabel}}</button><button data-action="adjust">Set {{pointLabel}}</button><button data-action="undo"><i class="fas fa-undo"></i> Undo</button>{{/if}}<button data-action="edit"><i class="fas fa-pen-to-square"></i> Edit Encounter</button>{{#if canTriggerVictorySplash}}<button data-action="victory-splash"><i class="fas fa-trophy"></i> Show Victory Splash</button>{{/if}}{{#if canPause}}<button class="pause-encounter" data-action="pause"><i class="fas fa-pause"></i> Pause</button><button class="end-encounter" data-action="end-encounter"><i class="fas fa-flag-checkered"></i> End & Publish</button>{{/if}}{{#if canResume}}<button class="resume-encounter" data-action="resume"><i class="fas fa-play"></i> Resume</button>{{/if}}</footer>{{/if}}
  </div><div class="tab" data-group="tracker" data-tab="log">{{#if checkLog.length}}<div class="check-log"><div class="check-log-header"><strong>PC</strong><strong>Target</strong><strong>Check</strong><strong>Skill</strong><strong>Outcome</strong></div>{{#each checkLog}}<div class="check-log-record"><div class="check-log-entry"><span>{{actorName}}</span><span>{{npcName}}</span><span>{{typeLabel}}</span><span>{{skillLabel}}</span><span>{{displayOutcome}}</span></div>{{#if details.length}}<div class="check-log-detail"><strong>{{detailLabel}}:</strong><ul>{{#each details}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}{{#if @root.isGM}}{{#if pendingDiscovery}}<div class="check-log-detail pending-discovery"><strong>Discovery choice pending.</strong> <button data-action="resolve-pending-discovery" data-id="{{pendingDiscovery.id}}"><i class="fa-solid fa-eye"></i> Resolve Discovery ({{pendingDiscovery.choices}})</button></div>{{/if}}{{/if}}</div>{{/each}}</div>{{else}}<p class="hint empty-log">No checks have been completed.</p>{{/if}}</div></div>
  {{/if}}
</section>
