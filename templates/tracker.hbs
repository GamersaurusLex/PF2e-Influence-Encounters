<section class="influence-tracker {{#unless isGM}}player-view{{/unless}}">
  {{#if isStarship}}
  <header class="encounter-header starship-header"><img src="{{heart.image}}" alt="{{heart.name}}"><div><h2>{{encounter.name}}{{#if isPaused}} (Paused){{/if}}</h2><p>Round {{encounter.currentRound}} · {{#if roleSelectionStage}}Crew role selection{{else}}Crew actions{{/if}}</p></div><div class="points">Countdown {{starship.countdown.value}} / {{starship.countdown.limit}}</div></header>
  {{#unless manualMode}}{{#if tableSpotlight}}<p class="influence-table-status"><i class="fas fa-gavel"></i> Now resolving: <strong>{{tableSpotlight.actorName}}</strong> → <strong>{{tableSpotlight.npcName}}</strong></p>{{/if}}{{/unless}}
  <nav class="tracker-tabs tabs" data-group="tracker"><a class="item {{tabs.encounter.cssClass}}" data-action="tab" data-group="tracker" data-tab="encounter"><i class="fas fa-shuttle-space"></i> Starship Encounter</a><a class="item {{tabs.log.cssClass}}" data-action="tab" data-group="tracker" data-tab="log"><i class="fas fa-list"></i> Check Log</a></nav>
  <div class="tracker-content"><div class="tab {{tabs.encounter.cssClass}}" data-group="tracker" data-tab="encounter">
    <section class="starship-status-grid">
      <article class="starship-ship-card"><img src="{{primorata.image}}" alt="{{primorata.name}}"><div><h3>{{primorata.name}}</h3><p>{{primorata.hullStatus}}</p>{{#if isGM}}<small>Hull {{primorata.hp}} / {{primorata.maxHp}} · Shields {{primorata.shields}} / {{primorata.shieldRefresh}} · AC {{primorata.ac}}</small>{{/if}}</div></article>
      <article class="starship-ship-card threat"><img src="{{heart.image}}" alt="{{heart.name}}"><div><h3>{{heart.name}}</h3><p>{{heart.hullStatus}}</p>{{#if isGM}}<small>Hull {{heart.hp}} / {{heart.maxHp}} · Shields {{heart.shields}} / {{heart.shieldRefresh}} · AC {{heart.ac}}</small>{{/if}}</div></article>
    </section>
    <section class="starship-countdown"><strong>Countdown</strong><span>{{starship.countdown.value}} / {{starship.countdown.limit}}</span>{{#if isGM}}<button data-action="starship-adjust" data-path="countdown" data-delta="-1"><i class="fas fa-minus"></i></button><button data-action="starship-adjust" data-path="countdown" data-delta="1"><i class="fas fa-plus"></i></button>{{/if}}</section>
    <section class="starship-crew-roster"><div class="starship-section-heading"><h3>Crew</h3><small>Round assignments</small></div><ul class="participant-roster compact-participant-roster">{{#each actors}}<li class="{{#if acted}}acted{{/if}}"><i class="fas {{#if acted}}fa-check-circle{{else}}fa-circle{{/if}}"></i><span>{{name}}</span><small>{{roleLabel}}{{#if acted}} · acted{{/if}}</small></li>{{/each}}</ul></section>
    {{#if showParticipantSelector}}<h4>Choose Your PC</h4><div class="participants participant-actions">{{#each controlledActors}}<button type="button" data-action="select-participant" data-actor-id="{{id}}" class="participant {{#if selected}}selected{{/if}} {{#if acted}}acted{{/if}}"><i class="fas fa-user"></i> {{name}}</button>{{/each}}</div>{{/if}}
    {{#if roleSelectionStage}}
    <section class="starship-role-board"><h3>Claim a Crew Role</h3><p class="hint">Choose any open role for this round. The GM begins crew actions when ready.</p>{{#each roleEntries}}<article class="starship-role-card {{#if selected}}selected{{/if}}"><div><h4>{{label}} <small>{{assignments.length}} / {{capacity}}</small></h4>{{#if assignments.length}}<p>{{#each assignments}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{else}}<p>Open</p>{{/if}}</div>{{#if @root.canClaimRole}}<button data-action="claim-starship-role" data-role-id="{{id}}" {{#if claimDisabled}}disabled{{/if}}>Claim {{label}}</button>{{/if}}</article>{{/each}}</section>
    {{#if isGM}}<footer><button data-action="start-starship-round" {{#unless roleSelectionComplete}}title="Some participating PCs have not claimed a role"{{/unless}}><i class="fas fa-play"></i> Start Round</button><button data-action="edit"><i class="fas fa-pen-to-square"></i> Edit Encounter</button>{{#if canOpenForPlayers}}<button data-action="open-for-players"><i class="fas fa-up-right-from-square"></i> Open for Players</button>{{/if}}{{#if canPause}}<button class="pause-encounter" data-action="pause"><i class="fas fa-pause"></i> Pause</button>{{/if}}</footer>{{/if}}
    {{else}}
    {{#if manualMode}}<p class="hint influence-manual-mode-note">Manual Mode: choose an action, roll at the table, then mark it resolved. The GM records the outcome.</p>{{/if}}
    {{#if selectedRole}}<section class="starship-action-board"><h3>{{selectedRole.label}} Actions</h3>{{#if activities.length}}{{#each activities}}<article class="starship-action-card {{#if selected}}selected{{/if}}"><button data-action="select-starship-action" data-activity-id="{{id}}"><strong>{{label}}</strong><small>{{difficulty}}</small></button>{{#if selected}}<p>{{description}}</p>{{#if choices.length}}<select data-starship-skill data-activity-id="{{id}}">{{#each choices}}<option value="{{slug}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<p class="hint">This PC has no trained eligible statistic for this activity.</p>{{/if}}{{/if}}</article>{{/each}}{{else}}<p class="hint">Select a crew role before choosing an action.</p>{{/if}}{{#if canTakeStarshipAction}}<button class="starship-take-action" data-action="take-starship-action"><i class="fas fa-paper-plane"></i> {{starshipActionButtonLabel}}</button>{{/if}}</section>{{else}}<p class="hint">Select one of your participating PCs, then claim a role before the GM starts the round.</p>{{/if}}
    {{#if isGM}}<footer><button data-action="next-starship-round" {{#unless canNextStarshipRound}}disabled{{/unless}}><i class="fas fa-forward"></i> Begin Next Round</button><button data-action="starship-adjust" data-path="primorata.hp" data-delta="-1">Primorata −1 Hull</button><button data-action="starship-adjust" data-path="primorata.hp" data-delta="1">Primorata +1 Hull</button><button data-action="starship-adjust" data-path="heart.hp" data-delta="-1">Heart −1 Hull</button><button data-action="starship-adjust" data-path="heart.hp" data-delta="1">Heart +1 Hull</button><button data-action="undo"><i class="fas fa-undo"></i> Undo Last Check</button><button data-action="edit"><i class="fas fa-pen-to-square"></i> Edit Encounter</button>{{#if canPause}}<button class="pause-encounter" data-action="pause"><i class="fas fa-pause"></i> Pause</button>{{/if}}</footer>{{/if}}
    {{/if}}
    {{#if isGM}}{{#if pendingChecks.length}}<section class="pending-check-queue"><h3>Pending Crew Actions</h3>{{#each pendingChecks}}<article><span class="queue-position">{{position}}</span><div><strong>{{actorName}} — {{activityLabel}}</strong><small>{{skillLabel}}</small></div><button type="button" data-action="adjudicate-request" data-id="{{id}}"><i class="fas fa-gavel"></i> Adjudicate</button><button type="button" data-action="cancel-request" data-id="{{id}}"><i class="fas fa-xmark"></i> Cancel</button></article>{{/each}}</section>{{/if}}{{/if}}
  </div><div class="tab {{tabs.log.cssClass}}" data-group="tracker" data-tab="log">{{#if checkLog.length}}<div class="check-log"><div class="check-log-header"><strong>PC</strong><strong>Target</strong><strong>Check</strong><strong>Skill</strong><strong>Outcome</strong></div>{{#each checkLog}}<div class="check-log-entry"><span>{{actorName}}</span><span>{{npcName}}</span><span>{{typeLabel}}</span><span>{{skillLabel}}</span><span>{{displayOutcome}}</span></div>{{/each}}</div>{{else}}<p class="hint empty-log">No crew actions have been completed.</p>{{/if}}</div></div>
  {{else}}
  {{#if noEncounter}}<p>No active encounter.</p>{{#if isGM}}<button data-action="manage"><i class="fas fa-cog"></i> Manage Encounters</button>{{/if}}{{else}}
  <header class="encounter-header"><img src="{{activeNpc.image}}" alt="{{activeNpc.name}}"><div><h2>{{#if playerSingleInfluence}}{{activeNpc.name}}{{else}}{{encounter.name}}{{/if}}{{#if isPaused}} (Paused){{/if}}</h2><p>{{#if playerSingleInfluence}}Phase {{encounter.currentPhase}} of {{encounter.phases}}{{else}}{{#if isInfiltration}}Round {{encounter.currentRound}} · {{infiltrationObjective.name}}{{else}}{{activeNpc.name}} · {{#if isResearch}}{{encounter.researchInterval.value}} {{encounter.researchInterval.unit}} interval{{else}}{{#if isChase}}Round {{encounter.currentRound}}{{#if isBeatClock}} of {{encounter.roundLimit}}{{/if}}{{else}}{{#if isSkill}}Round {{encounter.currentRound}}{{#if encounter.roundLimit}} of {{encounter.roundLimit}}{{/if}}{{else}}Phase {{encounter.currentPhase}} of {{encounter.phases}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}</p></div><div class="points">{{#if isInfiltration}}Awareness {{infiltration.awareness.points}} / {{infiltration.awareness.maximum}}{{else}}{{#if showPoints}}{{currentPoints}}{{#if isChase}} / {{activeNpc.maximumPoints}}{{else}}{{#if goalBasedSkillEncounter}} / {{encounter.skillPointGoal}}{{/if}}{{/if}} {{pointLabel}}{{else}}— {{pointLabel}}{{/if}}{{/if}}</div></header>
  {{#unless manualMode}}{{#if tableSpotlight}}<p class="influence-table-status"><i class="fas fa-gavel"></i> Now resolving: <strong>{{tableSpotlight.actorName}}</strong> → <strong>{{tableSpotlight.npcName}}</strong></p>{{/if}}{{/unless}}
  <nav class="tracker-tabs tabs" data-group="tracker"><a class="item {{tabs.encounter.cssClass}}" data-action="tab" data-group="tracker" data-tab="encounter"><i class="fas fa-comments"></i> Encounter</a><a class="item {{tabs.log.cssClass}}" data-action="tab" data-group="tracker" data-tab="log"><i class="fas fa-list"></i> Check Log</a></nav>
  {{#if playerRollChecks.length}}<section class="player-roll-queue player-action-dock" aria-live="polite"><h3>Your Action</h3>{{#each playerRollChecks}}<article><div>{{#if canRoll}}<strong>Approved: rolling {{skillLabel}}…</strong>{{else}}<strong>Roll recorded</strong>{{/if}}<small>{{actorName}} → {{npcName}}</small>{{#if canSubmit}}<small>Keep this result, or use one Fortune effect from the chat card (e.g., hero point, mythic point, bonus die, etc.).</small>{{/if}}</div>{{#if canSubmit}}<button type="button" data-action="submit-approved-check" data-id="{{id}}"><i class="fas fa-check"></i> Keep Result</button>{{/if}}</article>{{/each}}</section>{{/if}}
  <div class="tracker-content"><div class="tab {{tabs.encounter.cssClass}}" data-group="tracker" data-tab="encounter">
    {{#unless isGM}}{{#if showParticipantSelector}}<section class="player-participant-picker"><h4>{{#if manualMode}}Choose Your PC{{else}}Choose Your Acting PC{{/if}}</h4><div class="participants participant-actions">{{#each controlledActors}}<button type="button" data-action="select-participant" data-actor-id="{{id}}" class="participant {{#if acted}}acted{{/if}} {{#if selected}}selected{{/if}}" {{#unless @root.manualMode}}{{#if acted}}disabled{{/if}}{{/unless}}><i class="fas {{#if acted}}fa-check{{else}}fa-user{{/if}}"></i> {{name}}</button>{{/each}}</div></section>{{/if}}{{#if canAct}}<section class="player-primary-actions"><div><strong>Acting as {{selectedActorName}}</strong><small>{{#if playerSingleInfluence}}Choose what you want to try against {{activeNpc.name}}.{{else}}Choose a check when you are ready.{{/if}}</small></div><div class="player-actions">{{#if isResearch}}<button data-action="request" data-type="research"><i class="fas fa-book-open"></i> Make a Check</button>{{else}}{{#if isChase}}<button data-action="request" data-type="chase"><i class="fas fa-person-running"></i> Make a Check</button>{{else}}{{#if isInfiltration}}<button data-action="request" data-type="infiltration"><i class="fas fa-user-secret"></i> Make a Check</button>{{else}}{{#if isSkill}}<button data-action="request" data-type="skill"><i class="fas fa-dice-d20"></i> Make a Check</button>{{else}}<button data-action="request" data-type="discovery"><i class="fas fa-search"></i> Discovery Check</button><button data-action="request" data-type="influence"><i class="fas fa-comments"></i> Influence Check</button>{{/if}}{{/if}}{{/if}}{{/if}}</div></section>{{/if}}{{#if playerDescription}}<details class="encounter-player-details"><summary>Situation and Stakes</summary><p>{{playerDescription}}</p></details>{{/if}}{{/unless}}
    {{#if isChase}}{{#unless isBeatClock}}<section class="chase-overview"><img src="{{encounter.chaseSubject.image}}" alt="{{encounter.chaseSubject.name}}"><div><h3>{{encounter.chaseSubject.label}}: {{#if encounter.chaseSubject.nickname}}{{encounter.chaseSubject.nickname}}{{else}}{{encounter.chaseSubject.name}}{{/if}}</h3>{{#if obscureChaseCourse}}<small class="chase-relative-status">{{chaseSubjectStatus}}</small>{{else}}<small>Pace {{encounter.opponentPace}} · Acts {{encounter.subjectTurnOrder}} the party</small>{{/if}}</div></section>{{/unless}}{{/if}}
    {{#if isInfiltration}}<section class="npc-profile infiltration-overview"><h3>{{infiltrationObjective.name}}</h3>{{#if infiltrationObjective.description}}<p>{{infiltrationObjective.description}}</p>{{/if}}<p><strong>Awareness:</strong> {{infiltration.awareness.points}} / {{infiltration.awareness.maximum}} AP · <strong>Edge Points:</strong> {{edgePoints.party}} party{{#if edgePoints.personal}}, {{edgePoints.personal}} personal{{/if}}</p>{{#unless npcs.length}}<p class="hint">The GM has not revealed this objective’s obstacles yet.</p>{{/unless}}</section>{{/if}}
    {{#if showTargetSelector}}<h3>{{targetLabel}}</h3><div class="npc-status-list">{{#each npcs}}<button type="button" data-action="select-npc" data-npc-id="{{id}}" class="npc-status-card {{#if active}}selected{{/if}} {{#if subjectHere}}subject-here{{/if}}"><img src="{{image}}" alt=""><span><strong>{{name}}</strong>{{#if subjectHere}}<small><i class="fa-solid fa-location-dot"></i> {{@root.encounter.chaseSubject.label}} is here</small>{{/if}}{{#unless @root.isSkill}}{{#if showPoints}}<small>{{points}}{{#if @root.isResearch}}{{#if maximumPoints}} / {{maximumPoints}}{{/if}} RP · {{availability}}{{else}}{{#if @root.isChase}} / {{maximumPoints}} CP · {{availability}}{{else}} IP{{/if}}{{/if}}</small>{{/if}}{{/unless}}{{#if @root.isResearch}}{{#if researchActorState}}<small>{{@root.researchActorLabel}}: {{#if showPoints}}{{researchActorState.points}}{{#if researchActorState.maximum}} / {{researchActorState.maximum}}{{/if}} RP · {{/if}}{{researchActorState.availability}}</small>{{/if}}{{/if}}</span></button>{{/each}}</div>{{/if}}
    {{#if playerSingleInfluence}}{{#if activeNpc.appearance}}<details class="npc-profile player-single-influence-details"><summary>About {{activeNpc.name}}</summary><p><strong>Appearance:</strong> {{activeNpc.appearance}}</p></details>{{/if}}{{else}}<section class="npc-profile"><h3>{{activeNpc.name}}</h3>{{#if isInfiltration}}{{#if activeNpc.background}}<p>{{activeNpc.background}}</p>{{/if}}{{#if overcomeChecks.length}}<p><strong>Overcome:</strong> {{#each overcomeChecks}}{{label}}{{#if dcText}} ({{dcText}}){{/if}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}{{#if activeNpc.requirements}}<p><strong>Special:</strong> {{activeNpc.requirements}}</p>{{/if}}{{else}}{{#if isSkill}}{{#if activeNpc.background}}<p>{{activeNpc.background}}</p>{{/if}}{{#if overcomeChecks.length}}<p><strong>Checks:</strong> {{#each overcomeChecks}}{{label}}{{#if dcText}} ({{dcText}}){{/if}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}{{#if activeNpc.requirements}}<p><strong>Special:</strong> {{activeNpc.requirements}}</p>{{/if}}{{else}}{{#if isChase}}{{#if activeNpc.background}}<p>{{activeNpc.background}}</p>{{/if}}{{#if overcomeChecks.length}}<p><strong>Overcome:</strong> {{#each overcomeChecks}}{{label}}{{#if dcText}} ({{dcText}}){{/if}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}{{#if activeNpc.requirements}}<p><strong>Special:</strong> {{activeNpc.requirements}}</p>{{/if}}{{else}}{{#if isResearch}}{{#if activeNpc.background}}<p>{{activeNpc.background}}</p>{{/if}}{{#if activeNpc.requirements}}<p><strong>Requirements:</strong> {{activeNpc.requirements}}</p>{{/if}}{{#if researchChecks.length}}<div class="research-checks"><h4>Available Research Checks</h4><ul>{{#each researchChecks}}<li><strong>{{label}}{{#if dcText}} — {{dcText}}{{/if}}</strong>{{#if description}}<p>{{description}}</p>{{/if}}</li>{{/each}}</ul></div>{{/if}}{{else}}{{#if activeNpc.appearance}}<p><strong>Appearance:</strong> {{activeNpc.appearance}}</p>{{/if}}{{#if isGM}}{{#if activeNpc.background}}<p><strong>Background:</strong> {{activeNpc.background}}</p>{{/if}}{{#if activeNpc.personality}}<p><strong>Personality:</strong> {{activeNpc.personality}}</p>{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}</section>{{/if}}
    {{#if isGM}}<div class="threshold-track">{{#each thresholds}}<div class="threshold {{#if unlocked}}unlocked{{/if}}"><strong>{{points}}</strong><span>{{label}}</span></div>{{/each}}</div>{{/if}}
    {{#if showParticipantRoster}}<section class="participant-roster-section"><h3>Participants</h3><ul class="participant-roster compact-participant-roster">{{#each actors}}<li class="{{#if acted}}acted{{/if}}"><i class="fas {{#if acted}}fa-check-circle{{else}}fa-circle{{/if}}"></i><span>{{name}}</span>{{#if @root.individualSkillScoring}}{{#if @root.showPoints}} <strong>{{skillPoints}} SP</strong>{{/if}}{{/if}}{{#if acted}} <small>Acted</small>{{/if}}</li>{{/each}}</ul></section>{{/if}}
    {{#if isGM}}{{#if showParticipantSelector}}<h4>{{#if manualMode}}Choose Your PC{{else}}Choose Your Acting PC{{/if}}</h4><div class="participants participant-actions">{{#each controlledActors}}<button type="button" data-action="select-participant" data-actor-id="{{id}}" class="participant {{#if acted}}acted{{/if}} {{#if selected}}selected{{/if}}" {{#unless @root.manualMode}}{{#if acted}}disabled{{/if}}{{/unless}}><i class="fas {{#if acted}}fa-check{{else}}fa-user{{/if}}"></i> {{name}}</button>{{/each}}</div>{{/if}}{{else}}{{#if showNoControlledActors}}<p class="hint">You do not own any participating PCs.</p>{{/if}}{{/if}}
    {{#unless isResearch}}{{#if knownDiscoveries.length}}<section class="known-discoveries"><h3>Your Discoveries About {{activeNpc.name}}</h3><ul>{{#each knownDiscoveries}}<li>{{this}}</li>{{/each}}</ul></section>{{/if}}{{/unless}}
    {{#if manualMode}}<section class="manual-mode-guidance">{{#if manualInfluence}}<h3>Known Effective Approaches</h3>{{#if knownInfluenceSkills.length}}<ul>{{#each knownInfluenceSkills}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p>None confirmed yet. Review your discoveries and discuss an approach with the GM.</p>{{/if}}{{else}}<h3>Manual Mode</h3><p>Roll at the table; your GM records the outcome.</p>{{/if}}</section>{{/if}}
    <div class="results">{{#each thresholds}}{{#if unlocked}}<article><h4>{{label}}</h4><p>{{text}}</p>{{#if boons.length}}<ul>{{#each boons}}<li><strong>{{label}}</strong>{{#if description}} — {{description}}{{/if}}</li>{{/each}}</ul>{{/if}}</article>{{/if}}{{/each}}</div>
    {{#if isGM}}{{#if pendingChecks.length}}<section class="pending-check-queue"><h3>Pending Checks</h3>{{#each pendingChecks}}<article><span class="queue-position">{{position}}</span><div class="pending-check-summary"><strong>{{actorName}} — {{npcName}}</strong><small>{{skillLabel}}</small>{{#if statusLabel}}<small>{{statusLabel}}</small>{{/if}}</div><div class="pending-check-actions"><div class="pending-check-resolution-actions">{{#if canAdjudicate}}<button type="button" data-action="adjudicate-request" data-id="{{id}}"><i class="fas fa-gavel"></i> Adjudicate</button>{{/if}}<button type="button" data-action="resolve-request-manually" data-id="{{id}}"><i class="fas fa-wand-magic-sparkles"></i> Resolve Manually</button>{{#if canReopen}}<button type="button" data-action="reopen-player-roll" data-id="{{id}}"><i class="fas fa-rotate-left"></i> Reopen Player Roll</button>{{/if}}</div><div class="pending-check-cleanup-actions"><button type="button" data-action="forget-request" data-id="{{id}}" title="Remove a stuck or duplicate request without a cancellation card"><i class="fas fa-eraser"></i> Clear Stuck Request</button><button type="button" data-action="cancel-request" data-id="{{id}}" title="Cancel this request and notify the player in chat"><i class="fas fa-xmark"></i> Cancel Request</button></div></div></article>{{/each}}</section>{{/if}}{{/if}}
    {{#if isGM}}<footer>{{#if canPrior}}<button data-action="prior"><i class="fas fa-backward"></i> Prior Phase</button>{{/if}}{{#if canNext}}<button data-action="advance"><i class="fas fa-forward"></i> Next Phase</button>{{/if}}{{#if canNextRound}}<button data-action="next-round"><i class="fas fa-forward"></i> {{roundActionLabel}}</button>{{#if isChase}}<button data-action="pass-obstacle"><i class="fas fa-person-walking-arrow-right"></i> Pass / Unable</button>{{/if}}{{/if}}{{#if canDeclareChaseOutcome}}<button data-action="declare-chase-outcome" data-outcome="victory"><i class="fas fa-trophy"></i> Declare Victory</button><button data-action="declare-chase-outcome" data-outcome="failure"><i class="fas fa-flag"></i> Declare Failure</button>{{/if}}{{#if canDeclareSkillOutcome}}<button data-action="declare-skill-outcome" data-outcome="victory"><i class="fas fa-trophy"></i> Declare Success</button><button data-action="declare-skill-outcome" data-outcome="failure"><i class="fas fa-xmark"></i> Declare Failure</button>{{/if}}{{#if canDeclareInfiltrationOutcome}}<button data-action="declare-infiltration-outcome" data-outcome="success"><i class="fas fa-trophy"></i> Declare Success</button><button data-action="declare-infiltration-outcome" data-outcome="failure"><i class="fas fa-xmark"></i> Declare Failure</button>{{/if}}{{#if canPause}}{{#if isInfiltration}}<button data-action="spend-edge"><i class="fas fa-diamond"></i> Spend Edge Point</button><button data-action="adjust-infiltration-resource"><i class="fas fa-sliders"></i> Set AP / Edge</button><button data-action="trigger-infiltration-complication"><i class="fas fa-triangle-exclamation"></i> Trigger Complication</button>{{/if}}<button data-action="reset-actions">Reset Actions</button><button data-action="change-ip" data-delta="-1"><i class="fas fa-minus"></i> 1 {{pointLabel}}</button><button data-action="change-ip" data-delta="1"><i class="fas fa-plus"></i> 1 {{pointLabel}}</button><button data-action="adjust">Set {{pointLabel}}</button><button data-action="undo"><i class="fas fa-undo"></i> Undo Last Check</button>{{/if}}<button data-action="edit"><i class="fas fa-pen-to-square"></i> Edit Encounter</button>{{#if canRevealInfluenceRewards}}<button data-action="reveal-influence-rewards"><i class="fas fa-eye"></i> Reveal Outcomes Now</button>{{/if}}{{#if canOpenForPlayers}}<button data-action="open-for-players"><i class="fas fa-up-right-from-square"></i> Open for Players</button>{{/if}}{{#if canTriggerVictorySplash}}<button data-action="victory-splash"><i class="fas fa-trophy"></i> Show Victory Splash</button>{{/if}}{{#if canPause}}<button class="pause-encounter" data-action="pause"><i class="fas fa-pause"></i> Pause</button><button class="end-encounter" data-action="end-encounter"><i class="fas fa-flag-checkered"></i> End & Publish</button>{{/if}}{{#if canResume}}<button class="resume-encounter" data-action="resume"><i class="fas fa-play"></i> Resume</button>{{/if}}</footer>{{/if}}
  </div><div class="tab {{tabs.log.cssClass}}" data-group="tracker" data-tab="log">{{#if checkLog.length}}<div class="check-log"><div class="check-log-header"><strong>PC</strong><strong>Target</strong><strong>Check</strong><strong>Skill</strong><strong>Outcome</strong></div>{{#each checkLog}}<div class="check-log-record"><div class="check-log-entry"><span>{{actorName}}</span><span>{{npcName}}</span><span>{{typeLabel}}</span><span>{{skillLabel}}</span><span>{{displayOutcome}}</span></div>{{#if details.length}}<div class="check-log-detail"><strong>{{detailLabel}}:</strong><ul>{{#each details}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}{{#if @root.isGM}}{{#if pendingDiscovery}}<div class="check-log-detail pending-discovery"><strong>Discovery choice pending.</strong> <button data-action="resolve-pending-discovery" data-id="{{pendingDiscovery.id}}"><i class="fa-solid fa-eye"></i> Resolve Discovery ({{pendingDiscovery.choices}})</button></div>{{/if}}{{#if canCorrectOutcome}}<div class="check-log-detail"><button data-action="correct-outcome" data-id="{{id}}"><i class="fa-solid fa-pen-to-square"></i> Correct Outcome</button></div>{{/if}}{{/if}}</div>{{/each}}</div>{{else}}<p class="hint empty-log">No checks have been completed.</p>{{/if}}</div></div>
  {{/if}}
  {{/if}}
</section>
